<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product
      Id="*"
      Name="WallpaperLive"
      Language="1033"
      Version="$(var.AppVersion)"
      Manufacturer="Raflyf"
      UpgradeCode="F92A66DF-7B95-40A7-934B-0A1785996391">
    <Package
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perUser"
        Platform="x64"
        Description="WallpaperLive $(var.AppVersion) Setup"
        Comments="Live desktop wallpaper player for Windows 10 and 11" />

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="WallpaperLiveIcon.ico" SourceFile="$(var.RepoRoot)\assets\wallpaperlive.ico" />
    <Property Id="ARPPRODUCTICON" Value="WallpaperLiveIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Raflyf/WallpaperLive" />
    <Property Id="ARPNOREPAIR" Value="yes" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch WallpaperLive" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="WixShellExecTarget" Value="[#WallpaperLiveExe]" />

    <util:CloseApplication
        Id="CloseWallpaperLive"
        Target="wallpaperlive.exe"
        CloseMessage="no"
        EndSessionMessage="yes"
        PromptToContinue="no"
        RebootPrompt="no"
        Timeout="5" />

    <CustomAction
        Id="LaunchApplication"
        BinaryKey="WixCA"
        DllEntry="WixShellExec"
        Impersonate="yes" />

    <UI>
      <UIRef Id="WixUI_InstallDir" />
      <UIRef Id="WixUI_ErrorProgressText" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
    </UI>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.RepoRoot)\assets\wix-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.RepoRoot)\assets\wix-dialog.bmp" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="UserProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="WallpaperLive">
            <Directory Id="ScriptsFolder" Name="scripts" />
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AppMainComp" Guid="8E47E6B7-F3B6-4813-8B37-4920A6BB219F" Win64="yes">
        <RegistryValue
            Root="HKCU"
            Key="Software\Raflyf\WallpaperLive\Install"
            Name="InstallPath"
            Type="string"
            Value="[INSTALLFOLDER]"
            KeyPath="yes" />
        <File Id="WallpaperLiveExe" Source="$(var.AppExe)" />
        <File Id="ReadmeMd" Source="$(var.RepoRoot)\README.md" />
        <File Id="LicenseTxt" Source="$(var.RepoRoot)\LICENSE" />
        <File Id="ThirdPartyMd" Source="$(var.RepoRoot)\THIRD_PARTY.md" />
        <File Id="WallpaperLiveIcon" Source="$(var.RepoRoot)\assets\wallpaperlive.ico" />
        <Shortcut
            Id="ApplicationStartMenuShortcut"
            Directory="ProgramMenuFolder"
            Name="WallpaperLive"
            Description="Live desktop wallpaper player"
            Target="[#WallpaperLiveExe]"
            WorkingDirectory="INSTALLFOLDER"
            Icon="WallpaperLiveIcon.ico"
            Advertise="no">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="Raflyf.WallpaperLive" />
        </Shortcut>
        <RemoveFolder Id="RemoveProgramsFolder" Directory="UserProgramsFolder" On="uninstall" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ScriptsFolder">
      <Component Id="DecoderScriptComp" Guid="4B94B9D2-514A-4C9C-9514-31E5C0A4B88E" Win64="yes">
        <RegistryValue
            Root="HKCU"
            Key="Software\Raflyf\WallpaperLive\Install"
            Name="DecoderScript"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        <File Id="GetDecoderPs1" Source="$(var.RepoRoot)\scripts\Get-Decoder.ps1" />
        <RemoveFolder Id="RemoveScriptsFolder" Directory="ScriptsFolder" On="uninstall" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="WallpaperLive" Level="1">
      <ComponentRef Id="AppMainComp" />
      <ComponentRef Id="DecoderScriptComp" />
    </Feature>
  </Product>
</Wix>
